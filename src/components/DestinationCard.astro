---
const { title, summary, href, image, kicker = 'Objevte' } = Astro.props;
---
<a class="destination-card" href={href}>
  {image ? <img src={image} alt="" loading="lazy" /> : <div class="placeholder"></div>}
  <span class="shade"></span>
  <span class="copy"><small>{kicker}</small><strong>{title}</strong><span>{summary}</span><b>Prozkoumat <i>→</i></b></span>
</a>
<style>
  .destination-card { position: relative; display: grid; min-height: 27rem; overflow: hidden; border-radius: var(--radius); color: white; text-decoration: none; box-shadow: var(--shadow); }
  img, .placeholder, .shade, .copy { position: absolute; inset: 0; width: 100%; height: 100%; }
  img { object-fit: cover; transition: transform .5s; }
  .placeholder { background: linear-gradient(140deg, var(--sea), var(--ink)); }
  .shade { background: linear-gradient(180deg, transparent 20%, rgba(6,26,37,.9) 100%); }
  .copy { display: flex; height: auto; top: auto; padding: 1.5rem; flex-direction: column; align-items: flex-start; }
  small { color: #ffd19a; font-size: .72rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  strong { margin-top: .25rem; font-family: Georgia, serif; font-size: 2rem; font-weight: 500; }
  .copy > span { display: -webkit-box; margin-top: .55rem; overflow: hidden; color: rgba(255,255,255,.82); font-size: .9rem; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  b { margin-top: 1rem; font-size: .82rem; } i { font-style: normal; transition: margin .2s; }
  .destination-card:hover img { transform: scale(1.04); }
  .destination-card:hover i { margin-left: .35rem; }
</style>
