---
const { title, eyebrow, intro, image, imageAlt = '' } = Astro.props;
---
<section class:list={['page-hero', { 'page-hero--image': image }]}>
  {image && <img class="page-hero__image" src={image} alt={imageAlt} fetchpriority="high" />}
  <div class="page-hero__shade"></div>
  <div class="container page-hero__inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {intro && <p class="intro">{intro}</p>}
  </div>
</section>
<style>
  .page-hero { position: relative; display: grid; min-height: 27rem; place-items: end start; overflow: hidden; background: linear-gradient(135deg, #0c6f74, #14304a); color: white; }
  .page-hero__image, .page-hero__shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .page-hero__image { object-fit: cover; }
  .page-hero__shade { background: linear-gradient(90deg, rgba(9,30,42,.88) 0%, rgba(9,30,42,.45) 58%, rgba(9,30,42,.14) 100%); }
  .page-hero__inner { position: relative; padding-block: clamp(4rem, 9vw, 7.5rem); }
  h1 { max-width: 12ch; }
  .intro { max-width: 43rem; margin: 1.3rem 0 0; color: rgba(255,255,255,.88); font-size: clamp(1.05rem, 2vw, 1.3rem); }
  .eyebrow { color: #ffd19a; }
</style>
