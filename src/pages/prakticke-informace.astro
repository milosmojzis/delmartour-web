---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const page = await getEntry('pages', 'prakticke-informace');
if (!page) throw new Error('Chybí praktické informace.');
const { Content } = await render(page);
---
<BaseLayout title={page.data.title} description={page.data.summary} image={page.data.heroImage}>
  <PageHero {...page.data} intro={page.data.summary} image={page.data.heroImage} imageAlt={page.data.heroAlt} />
  <section class="section"><div class="container practical-grid"><article class="prose practical-list"><Content /></article><aside class="surface next-step"><p class="eyebrow">Domluva podle vás</p><h2>Máte otázky k cestě?</h2><p>Konkrétní podobu pobytu, dopravu i stravování s vámi rádi probereme.</p><a class="button" href="/o-nas/#kontakt">Kontaktovat agenturu →</a></aside></div></section>
</BaseLayout>
<style>
  .practical-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(18rem, .7fr); gap: clamp(2rem, 7vw, 6rem); align-items: start; }
  .practical-list :global(ul) { display: grid; gap: .8rem; margin: 0; padding: 0; list-style: none; }
  .practical-list :global(li) { position: relative; padding: 1.2rem 1.2rem 1.2rem 3.6rem; border: 1px solid var(--line); border-radius: 1rem; background: white; }
  .practical-list :global(li)::before { content: '✓'; position: absolute; top: 1.05rem; left: 1.2rem; display: grid; width: 1.6rem; height: 1.6rem; place-items: center; border-radius: 50%; background: #dff1ec; color: var(--sea-dark); font-weight: 900; }
  .next-step { padding: 1.7rem; background: var(--cream); }
  .next-step h2 { font-size: 2rem; }
  .next-step > p:not(.eyebrow) { color: var(--muted); }
  @media (max-width: 760px) { .practical-grid { grid-template-columns: 1fr; } }
</style>
