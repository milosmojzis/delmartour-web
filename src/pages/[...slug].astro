---
import { getCollection, type CollectionEntry } from 'astro:content';
import DestinationLayout from '../layouts/DestinationLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('destinations');
  return entries.map((entry) => ({
    params: { slug: entry.data.route.replace(/^\//, '').replace(/\/$/, '') },
    props: { entry, children: entries.filter((candidate) => candidate.data.parent === entry.id.replace(/\.md$/, '')) },
  }));
}

const { entry, children } = Astro.props as { entry: CollectionEntry<'destinations'>; children: CollectionEntry<'destinations'>[] };
---
<DestinationLayout entry={entry} children={children.sort((a, b) => a.data.order - b.data.order)} />
