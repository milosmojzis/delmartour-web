---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DestinationCard from '../components/DestinationCard.astro';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Chybí obsah úvodní stránky.');
const { Content } = await render(page);
const destinations = await getCollection('destinations');
const top = ['spanelsko', 'karibik', 'thajsko'].map((id) => destinations.find((item) => item.id === id)!).filter(Boolean);
const regions = destinations.filter((item) => item.data.parent === 'spanelsko').sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---
<BaseLayout title="Poznávací zájezdy" description={page.data.summary} image={page.data.heroImage}>
  <section class="home-hero">
    <img src={page.data.heroImage} alt={page.data.heroAlt} fetchpriority="high" />
    <div class="home-hero__shade"></div>
    <div class="container home-hero__content">
      <p class="eyebrow">{page.data.eyebrow}</p>
      <h1>{page.data.title}</h1>
      <p>{page.data.summary}</p>
      <div class="hero-actions"><a class="button button--light" href="#destinace">Objevte destinace ↓</a><a class="text-link" href="/o-nas/#kontakt">Spojte se s námi →</a></div>
    </div>
    <div class="hero-note"><span>Španělsko</span><span>Karibik</span><span>Thajsko</span></div>
  </section>

  <section class="section intro-section">
    <div class="container intro-grid">
      <div><p class="eyebrow">Osobně. Aktivně. S poznáním.</p><h2>Vydejte se za příběhy, ne jen za místy.</h2></div>
      <article class="prose"><Content /></article>
    </div>
  </section>

  <section id="destinace" class="section section--cream">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Kam s námi</p><h2>Tři světy k poznání</h2></div><p>Od evropské kultury přes karibské ostrovy až po vůně jihovýchodní Asie.</p></div>
      <div class="destination-grid">{top.map((destination) => <DestinationCard title={destination.data.title} summary={destination.data.summary} href={destination.data.route} image={destination.data.cardImage || destination.data.heroImage} />)}</div>
    </div>
  </section>

  <section class="section story-section">
    <div class="container story-grid">
      <div class="story-image"><img src="/images/home/papousek.jpg" alt="Barevný exotický papoušek" loading="lazy" /></div>
      <div class="story-copy"><p class="eyebrow">Pro každého něco jiného</p><h2>Poznávejte vlastním tempem</h2><p>Vydejte se s námi poznat královské Španělsko, kde se snoubí jižanský temperament s evropskými tradicemi.</p><p>Procestujte s naší cestovní agenturou tropické ostrovy Karibiku s pohádkově bílými plážemi a palmami plnými kokosových ořechů.</p><p>Pojeďte proniknout do tajů Thajska plného kořeněných vůní a jedinečných zážitků na každém kroku.</p><a class="button" href="/modelove-priklady/">Prohlédnout modelové cesty →</a></div>
    </div>
  </section>

  <section class="section regions">
    <div class="container"><p class="eyebrow">Španělsko zblízka</p><h2>Každý region má vlastní rytmus</h2><div class="region-grid">{regions.map((destination) => <DestinationCard title={destination.data.title} summary={destination.data.summary} href={destination.data.route} image={destination.data.cardImage || destination.data.heroImage} kicker="Oblast" />)}</div><div class="center"><a class="button button--ghost" href="/spanelsko/">Všechny oblasti Španělska →</a></div></div>
  </section>
</BaseLayout>
<style>
  .home-hero { position: relative; display: grid; min-height: calc(100svh - 5.4rem); overflow: hidden; place-items: center start; color: white; }
  .home-hero > img, .home-hero__shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .home-hero > img { object-fit: cover; }
  .home-hero__shade { background: linear-gradient(90deg, rgba(7,30,42,.86) 0%, rgba(7,30,42,.45) 55%, rgba(7,30,42,.08) 100%); }
  .home-hero__content { position: relative; padding-block: 5rem 8rem; }
  .home-hero h1 { max-width: 12ch; }
  .home-hero__content > p:not(.eyebrow) { max-width: 42rem; margin: 1.4rem 0 2rem; color: rgba(255,255,255,.86); font-size: clamp(1.05rem, 2vw, 1.3rem); }
  .home-hero .eyebrow { color: #ffd19a; }
  .hero-actions { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; }
  .text-link { color: white; font-weight: 750; }
  .hero-note { position: absolute; right: 2rem; bottom: 2rem; display: flex; gap: .5rem; }
  .hero-note span { padding: .45rem .75rem; border: 1px solid rgba(255,255,255,.4); border-radius: 999px; background: rgba(11,34,45,.25); font-size: .75rem; backdrop-filter: blur(8px); }
  .intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem, 9vw, 8rem); align-items: start; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.2rem; }
  .section-heading > p { max-width: 27rem; margin: 0; color: var(--muted); }
  .destination-grid, .region-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .story-section { overflow: hidden; }
  .story-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(2rem, 8vw, 7rem); align-items: center; }
  .story-image { position: relative; min-height: 34rem; }
  .story-image::before { content: ''; position: absolute; inset: -2rem 3rem 2rem -30vw; border-radius: 0 var(--radius) var(--radius) 0; background: var(--sea); }
  .story-image img { position: absolute; inset: 2rem 0 0; width: 100%; height: calc(100% - 2rem); border-radius: var(--radius); object-fit: cover; box-shadow: var(--shadow); }
  .story-copy p { color: var(--muted); }
  .story-copy .button { margin-top: .6rem; }
  .region-grid { margin-top: 2rem; }
  .center { margin-top: 2rem; text-align: center; }
  @media (max-width: 820px) { .intro-grid, .story-grid { grid-template-columns: 1fr; } .destination-grid, .region-grid { grid-template-columns: 1fr; } .section-heading { align-items: start; flex-direction: column; } .home-hero { min-height: 44rem; } .hero-note { right: .75rem; bottom: .75rem; } }
</style>
